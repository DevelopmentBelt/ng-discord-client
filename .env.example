# Database
MYSQL_ROOT_PASSWORD=root
DB_NAME=ng_discord
DB_USER=ng_discord
DB_PASS=ng_discord
DB_CHARSET=utf8mb4
DB_PORT=3306

# Host ports
API_PORT=80
WS_PORT=8080
FRONTEND_PORT=4200

# Password reset email links (used by API)
FRONTEND_URL=http://localhost:4200
MAIL_DRIVER=log
MAIL_FROM=noreply@angcord.local

# WebSocket: HTTP host clients use + bind address inside the container
WS_HTTP_HOST=localhost
WS_HOST=0.0.0.0
