DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_username
DB_PASS=your_password
DB_CHARSET=utf8mb4

# Frontend origin used in password-reset email links
FRONTEND_URL=http://localhost:4200

# mail = PHP mail(); log = write to backend/storage/password-resets.log and return resetUrl in API (local/dev)
MAIL_DRIVER=log
MAIL_FROM=noreply@nimbus.local
